# Equity Intelligence Dashboard — Environment Variables
# Copy this file to .env.local and fill in your values

# Required: Anthropic API key for Claude AI analysis
REACT_APP_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Alpha Vantage API key for real-time market data (free tier available)
# Get one at: https://www.alphavantage.co/support/#api-key
REACT_APP_ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Optional: Financial Modeling Prep API key for additional financial data
# Get one at: https://financialmodelingprep.com/developer/docs
REACT_APP_FMP_KEY=your_fmp_key_here
